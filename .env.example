# ---------------------------------------------------------------------------
# Finance Aggregator — environment configuration
# Copy this file to `.env` (repo root) and fill in as needed.
# The app runs fully local with NO cloud config. Everything below is optional
# and only needed to enable Gmail scanning or LLM categorization.
# ---------------------------------------------------------------------------

# Where the local SQLite database file lives (relative to repo root).
DATABASE_PATH=./data/finance.sqlite

# Backend port. In dev the frontend proxies /api to this; in production the
# backend also serves the built frontend from this same port.
PORT=4000

# Bind address. Default 127.0.0.1 = local only (recommended; pair with
# `tailscale serve` to reach it privately from your other devices).
# Set HOST=0.0.0.0 to listen on all interfaces (then firewall the port yourself).
HOST=127.0.0.1

# Default currency for the ledger. Configurable in Settings too.
DEFAULT_CURRENCY=ILS

# --- Encryption at rest for OAuth tokens (optional but recommended) ---------
# A 32-byte secret (any passphrase works; it is hashed to a key). If unset,
# tokens are stored unencrypted in the local DB.
TOKEN_ENCRYPTION_KEY=

# --- OCR (optional) ---------------------------------------------------------
# Point this at a folder of tesseract *.traineddata files (e.g. eng.traineddata,
# heb.traineddata from https://github.com/tesseract-ocr/tessdata_fast) to run
# receipt OCR fully offline. If unset, the data is downloaded on first use.
TESSDATA_PATH=

# --- Gmail API (OAuth 2.0, read-only) ---------------------------------------
# Create an OAuth Client (type: Desktop or Web) in Google Cloud Console,
# enable the Gmail API, and paste the client id/secret here.
# See README "Google OAuth setup" for step-by-step instructions.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/email/gmail/callback

# --- Outlook / Microsoft 365 (OAuth 2.0, read-only Mail.Read) ---------------
# Register an app in the Azure Portal (App registrations), add the redirect URI
# below as a "Web" platform, and create a client secret.
# See README "Microsoft / Outlook setup" for step-by-step instructions.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:4000/api/email/outlook/callback
# 'common' = work + personal accounts, 'consumers' = personal only, or a tenant id.
OUTLOOK_TENANT=common

# --- IMAP fallback (optional, alternative to Gmail/Outlook APIs) -------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Anthropic API (optional LLM categorization) ----------------------------
# Only used when LLM categorization is toggled ON in Settings. When enabled,
# ONLY normalized merchant names are sent to the API — never full statements.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
