# Copy to .env and fill in. NEVER commit the real .env.
#
# Generate a strong token, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CYBER_EXEC_TOKEN=replace-with-a-long-random-token

