# Copy to .env and fill in. NEVER commit the real .env.
#
# Generate a strong token, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CYBER_EXEC_TOKEN=replace-with-a-long-random-token

# Optional overrides (defaults shown):
# SEC_TOOLBOX_IMAGE=sec-toolbox:latest
# SEC_TOOLBOX_USER=runner
# SEC_TOOLBOX_PIDS=512
# SEC_TOOLBOX_MEMORY=2g
# SEC_TOOLBOX_CPUS=2
#
# Host-visible root for throwaway per-request workdirs. MUST be a real path the
# Docker daemon can see (NOT a systemd PrivateTmp /tmp). The systemd unit sets
# this to /var/lib/cyber-exec/work; run.sh defaults it to <repo>/.work.
# CYBER_EXEC_WORKROOT=/var/lib/cyber-exec/work

# --- Heavy image (reserved, opt-in via {"image":"heavy"}); base untouched ---
# SEC_TOOLBOX_HEAVY_IMAGE=sec-toolbox-heavy:latest
# SEC_TOOLBOX_HEAVY_MEMORY=4g
# SEC_TOOLBOX_HEAVY_CPUS=4
# SEC_TOOLBOX_HEAVY_TIMEOUT_DEFAULT=300
# SEC_TOOLBOX_HEAVY_TIMEOUT_CAP=1800
#
# Optional read-only Volatility3 symbol cache (host dir). When set, it is
# bind-mounted read-only at /opt/vol-symbols in the HEAVY container only.
# Pre-populate it offline; leave empty to mount nothing beyond /work.
# SEC_TOOLBOX_VOL_CACHE=/var/lib/cyber-exec/vol-symbols
