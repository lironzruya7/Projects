# sec-toolbox-heavy:latest — RESERVED, opt-in RE/forensics image.
#
# This is NOT the default. The lean `sec-toolbox:latest` stays the default for
# fast spin-up (whois/nmap/etc.); this image is only used when a request sets
# {"image":"heavy"}. It is built FROM the base, so it is literally base + the
# heavy additions below — the base build/tag is never modified.
#
# Build order (on the box):
#   docker build -t sec-toolbox:latest       -f docker/Dockerfile.sec-toolbox docker/
#   docker build -t sec-toolbox-heavy:latest -f docker/Dockerfile.heavy       docker/
#
# Adds: OpenJDK 21, Ghidra (headless; analyzeHeadless on PATH), Volatility3,
# plus yara (already in base), capa, floss. No GUI, no Android tooling.
FROM sec-toolbox:latest

USER root
ENV DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# Java (for Ghidra) + unzip. Ghidra 11.2+ needs JDK 21.
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-21-jdk-headless \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Volatility3 + capa + floss (yara CLI already present in base).
# NOTE: no Windows symbol packs are baked in — vol3 resolves ISF symbols from
# an (optionally mounted, pre-populated) cache at run time. See README.
# ---------------------------------------------------------------------------
RUN pip3 install --no-cache-dir --break-system-packages \
        volatility3 \
        flare-capa \
        flare-floss

# ---------------------------------------------------------------------------
# Ghidra — official release, headless only.
# Pinned to a known-good asset; override with --build-arg if superseded.
# GHIDRA_SHA256 is optional: if set, the download is integrity-checked. Get the
# value from the release page and pass it for a verified build (recommended).
# ---------------------------------------------------------------------------
ARG GHIDRA_VERSION=11.2.1
ARG GHIDRA_DATE=20241105
ARG GHIDRA_SHA256=
RUN set -eux; \
    base="https://github.com/NationalSecurityAgency/ghidra/releases/download"; \
    zip="ghidra_${GHIDRA_VERSION}_PUBLIC_${GHIDRA_DATE}.zip"; \
    url="${base}/Ghidra_${GHIDRA_VERSION}_build/${zip}"; \
    echo "Fetching ${url}"; \
    curl -fSL -o /tmp/ghidra.zip "${url}"; \
    if [ -n "${GHIDRA_SHA256}" ]; then \
        echo "${GHIDRA_SHA256}  /tmp/ghidra.zip" | sha256sum -c -; \
    else \
        echo "WARNING: GHIDRA_SHA256 not set — skipping integrity check"; \
    fi; \
    unzip -q /tmp/ghidra.zip -d /opt; \
    mv "/opt/ghidra_${GHIDRA_VERSION}_PUBLIC" /opt/ghidra; \
    ln -s /opt/ghidra/support/analyzeHeadless /usr/local/bin/analyzeHeadless; \
    rm -f /tmp/ghidra.zip; \
    analyzeHeadless -help >/dev/null 2>&1 || true

ENV GHIDRA_INSTALL_DIR=/opt/ghidra

# ---------------------------------------------------------------------------
# Optional persistent Volatility3 symbol cache mount point (read-only at run
# time — see the API's SEC_TOOLBOX_VOL_CACHE plumbing). Pre-populate offline.
# ---------------------------------------------------------------------------
RUN mkdir -p /opt/vol-symbols && chown runner:runner /opt/vol-symbols

# Back to the non-root runtime user inherited from the base image (uid 999).
USER runner
WORKDIR /work

CMD ["bash"]
