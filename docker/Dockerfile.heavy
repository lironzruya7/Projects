# sec-toolbox-heavy:latest — RESERVED, opt-in RE/forensics image.
#
# This is NOT the default. The lean `sec-toolbox:latest` stays the default for
# fast spin-up (whois/nmap/etc.); this image is only used when a request sets
# {"image":"heavy"}. It is built FROM the base, so it is literally base + the
# heavy additions below — the base build/tag is never modified.
#
# Build order (on the box):
#   docker build -t sec-toolbox:latest       -f docker/Dockerfile.sec-toolbox docker/
#   docker build -t sec-toolbox-heavy:latest -f docker/Dockerfile.heavy       docker/
#
# Adds: OpenJDK 21, Ghidra (headless; analyzeHeadless on PATH), Volatility3,
# plus yara (already in base), capa, floss. No GUI, no Android tooling.
FROM sec-toolbox:latest

USER root
ENV DEBIAN_FRONTEND=noninteractive

# ---------------------------------------------------------------------------
# Java (for Ghidra) + unzip + build prereqs for any source-built wheels
# (Kali ships Python 3.13; some deps may need compiling). Ghidra 11.2+ = JDK 21.
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-21-jdk-headless \
        unzip \
        build-essential \
        python3-dev \
        libffi-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --break-system-packages --upgrade pip setuptools wheel

# ---------------------------------------------------------------------------
# Volatility3 — REQUIRED (forensics smoke depends on it). Installed on its own
# so its resolver run can't be broken by capa/floss dependency pins.
# NOTE: no Windows symbol packs are baked in — vol3 resolves ISF symbols from
# an (optionally mounted, pre-populated) cache at run time. See README.
# ---------------------------------------------------------------------------
RUN pip3 install --no-cache-dir --break-system-packages volatility3

# capa + floss — OPTIONAL tight add-ons (yara CLI already in base). Their
# dependency trees are heavier; if they don't resolve on this Python they must
# NOT fail the image (the required tools are Ghidra + vol3). Installed
# separately and best-effort; a WARNING is printed if either is unavailable.
RUN pip3 install --no-cache-dir --break-system-packages flare-capa \
      || echo "WARNING: flare-capa not installed (optional)"
RUN pip3 install --no-cache-dir --break-system-packages flare-floss \
      || echo "WARNING: flare-floss not installed (optional)"

# ---------------------------------------------------------------------------
# Ghidra — official release, headless only.
# Pinned to a known-good asset; override with --build-arg if superseded.
# GHIDRA_SHA256 is optional: if set, the download is integrity-checked. Get the
# value from the release page and pass it for a verified build (recommended).
# ---------------------------------------------------------------------------
ARG GHIDRA_VERSION=11.2.1
ARG GHIDRA_DATE=20241105
# REQUIRED: the SHA-256 of the release zip (from the Ghidra release page). The
# build fails without it, so no unverified Ghidra ever lands in the image.
#   docker build ... --build-arg GHIDRA_SHA256=<sha256>
ARG GHIDRA_SHA256
RUN set -eux; \
    if [ -z "${GHIDRA_SHA256}" ]; then \
        echo "ERROR: GHIDRA_SHA256 build-arg is required (get it from the Ghidra release page)"; \
        exit 1; \
    fi; \
    base="https://github.com/NationalSecurityAgency/ghidra/releases/download"; \
    zip="ghidra_${GHIDRA_VERSION}_PUBLIC_${GHIDRA_DATE}.zip"; \
    url="${base}/Ghidra_${GHIDRA_VERSION}_build/${zip}"; \
    echo "Fetching ${url}"; \
    curl -fSL -o /tmp/ghidra.zip "${url}"; \
    echo "${GHIDRA_SHA256}  /tmp/ghidra.zip" | sha256sum -c -; \
    unzip -q /tmp/ghidra.zip -d /opt; \
    mv "/opt/ghidra_${GHIDRA_VERSION}_PUBLIC" /opt/ghidra; \
    ln -s /opt/ghidra/support/analyzeHeadless /usr/local/bin/analyzeHeadless; \
    rm -f /tmp/ghidra.zip; \
    analyzeHeadless -help >/dev/null 2>&1 || true

ENV GHIDRA_INSTALL_DIR=/opt/ghidra

# ---------------------------------------------------------------------------
# Native font stack for Ghidra headless. Even in headless mode some analyzers
# touch AWT font metrics (e.g. GccExceptionAnalyzer setting comments) and the
# JVM throws loading libfontmanager without freetype/fontconfig/a font present.
# Kept as its own late layer so the (large) Ghidra download layer stays cached.
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        libharfbuzz0b \
        libfreetype6 \
        libfontconfig1 \
        fontconfig \
        fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Optional persistent Volatility3 symbol cache mount point (read-only at run
# time — see the API's SEC_TOOLBOX_VOL_CACHE plumbing). Pre-populate offline.
# ---------------------------------------------------------------------------
RUN mkdir -p /opt/vol-symbols && chown runner:runner /opt/vol-symbols

# Back to the non-root runtime user inherited from the base image (uid 999).
USER runner
WORKDIR /work

CMD ["bash"]
