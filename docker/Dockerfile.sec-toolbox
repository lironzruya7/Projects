# sec-toolbox:latest — security-analysis toolbox image.
#
# Build:
#   docker build -t sec-toolbox:latest -f docker/Dockerfile.sec-toolbox docker/
#
# The container runs as a NON-root user (`runner`). It carries a broad set of
# recon / analysis / forensics tools. Heavier tools (Volatility3, Ghidra) are
# intentionally left out — put those in a separate, larger optional image.
#
# Base: Kali rolling — ships ffuf, nuclei, nikto, radare2, etc. straight from
# apt, so no separate Go-tool release downloads are needed.
FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PATH="/opt/tools/bin:${PATH}"

# ---------------------------------------------------------------------------
# Distro packages
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        wget \
        git \
        bash \
        jq \
        # recon / network / web
        nmap \
        masscan \
        whois \
        dnsutils \
        nikto \
        ffuf \
        nuclei \
        # tls / capture
        tshark \
        # binary / malware / forensics
        binwalk \
        yara \
        radare2 \
        libimage-exiftool-perl \
        # python + build helpers for pip tools
        python3 \
        python3-pip \
        python3-venv \
        sqlmap \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# testssl.sh (shell script, pinned tag)
# ---------------------------------------------------------------------------
ARG TESTSSL_VERSION=3.2
RUN set -eux; \
    mkdir -p /opt/tools/bin; \
    git clone --depth 1 --branch "v${TESTSSL_VERSION}" \
        https://github.com/drwetter/testssl.sh.git /opt/testssl; \
    ln -s /opt/testssl/testssl.sh /opt/tools/bin/testssl.sh

# ---------------------------------------------------------------------------
# Python-based tools: requests, oletools, pdfid/pdf-parser (via pdfid pkg)
# ---------------------------------------------------------------------------
RUN set -eux; \
    pip3 install --no-cache-dir --break-system-packages \
        requests \
        oletools \
        pdfid \
        pdf-parser

# ---------------------------------------------------------------------------
# Non-root runtime user. /work is the mount point for the throwaway workdir.
# ---------------------------------------------------------------------------
RUN useradd --create-home --uid 1000 --shell /bin/bash runner \
    && mkdir -p /work \
    && chown runner:runner /work

USER runner
WORKDIR /work

# Default to an interactive-ish shell; the exec agent overrides the command.
CMD ["bash"]
